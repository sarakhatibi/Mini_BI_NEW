# Optional runtime settings for the Streamlit app.
# Copy to .env and adjust as needed; none of these are required locally.

# Streamlit server
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true

# Maximum upload size in megabytes
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=200

# Default dataset shown by the "sample data" button
SAMPLE_DATA_PATH=data/Test_Dataset.xlsx
